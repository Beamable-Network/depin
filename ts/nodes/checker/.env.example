# Logging Configuration (Optional - has defaults)
# LOG_LEVEL=debug
# LOG_FORMAT=pretty (pretty=human-readable with colors, json=structured JSON for Docker/monitoring)

# OpenTelemetry Configuration (Optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Solana Configuration (Required)
SOLANA_NETWORK=devnet
# SOLANA_RPC_URL=YOUR_SOLANA_RPC_URL

# Helius API Key (Required)
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# Checker Wallet (Required)
CHECKER_PRIVATE_KEY=[1,2,3,...,64]  # JSON array from solana-keygen grind

# Checker Licenses (Optional - comma-separated list of license addresses)
# If not provided, will search for activated licenses on-chain where you're the delegate
# CHECKER_LICENSES=license_address_1,license_address_2

# Skip BRAND algorithm validation (Optional - defaults to false)
# Set to true to skip BRAND assignment validation (for testing/debugging)
# SKIP_BRAND=false

# Rate Limiting / Throttle Configuration (Optional - has defaults)
# Controls how often RPC operations are made to respect rate limits
# Format: THROTTLE_<OPERATION>_LIMIT=<number of calls> THROTTLE_<OPERATION>_INTERVAL=<milliseconds>

# Send Transaction throttle (default: 1 call per 1100ms)
# THROTTLE_SEND_TX_LIMIT=1
# THROTTLE_SEND_TX_INTERVAL=1100

# Get Program Accounts throttle (default: 5 calls per 1100ms)
# THROTTLE_GET_ACCOUNTS_LIMIT=5
# THROTTLE_GET_ACCOUNTS_INTERVAL=1100

# Get Asset With Proof throttle (default: 1 call per 600ms)
# THROTTLE_GET_ASSET_LIMIT=1
# THROTTLE_GET_ASSET_INTERVAL=600