# Server Configuration (Optional - has defaults)
# PORT=3000
# HOST=0.0.0.0

# Logging Configuration (Optional - has defaults)
# LOG_LEVEL=debug
# LOG_FORMAT=pretty (pretty=human-readable with colors, json=structured JSON for Docker/monitoring)

# OpenTelemetry Configuration (Optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Solana Configuration (Required)
SOLANA_NETWORK=devnet

# Helius API Key (Required)
# Get a free tier key at https://www.helius.dev/
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# Worker Wallet (Required)
WORKER_PRIVATE_KEY=[1,2,3,...,64]  # JSON array from solana-keygen or base58 string

# Worker License (Required)
WORKER_LICENSE=YOUR_WORKER_LICENSE_ADDRESS

# External URL (Required)
# The public URL where this worker can be reached by checkers
EXTERNAL_URL=https://your-worker-domain.com

# S3 Configuration (Required)
# S3-compatible storage for proof data
S3_BUCKET_NAME=your-bucket-name
S3_BUCKET_PATH=  # Optional path prefix
S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key  # Optional if using IAM roles
# S3_SECRET_ACCESS_KEY=your-secret-key  # Optional if using IAM roles

# Rate Limiting / Throttle Configuration (Optional - has defaults)
# Controls how often RPC operations are made to respect rate limits
# Format: THROTTLE_<OPERATION>_LIMIT=<number of calls> THROTTLE_<OPERATION>_INTERVAL=<milliseconds>

# Send Transaction throttle (default: 1 call per 1100ms)
# THROTTLE_SEND_TX_LIMIT=1
# THROTTLE_SEND_TX_INTERVAL=1100

# Search Assets throttle (default: 5 calls per 1100ms)
# THROTTLE_SEARCH_ASSETS_LIMIT=5
# THROTTLE_SEARCH_ASSETS_INTERVAL=1100