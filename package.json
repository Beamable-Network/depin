{
  "name": "beamable-depin-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Beamable DePIN monorepo - Solana programs, SDK, and node implementations",
  "scripts": {
    "changelog:sdk": "git-cliff --include-path 'ts/packages/beamable-depin/**' --tag-pattern 'sdk-v[0-9]*' --output ts/packages/beamable-depin/CHANGELOG.md",
    "changelog:worker": "git-cliff --include-path 'ts/nodes/worker/**' --tag-pattern 'worker-v[0-9]*' --output ts/nodes/worker/CHANGELOG.md",
    "changelog:checker": "git-cliff --include-path 'ts/nodes/checker/**' --tag-pattern 'checker-v[0-9]*' --output ts/nodes/checker/CHANGELOG.md",
    "changelog:depin": "git-cliff --include-path 'rust/programs/depin/**' --tag-pattern 'depin-v[0-9]*' --output rust/programs/depin/CHANGELOG.md",
    "changelog:worker-stake": "git-cliff --include-path 'rust/programs/worker_stake/**' --tag-pattern 'worker-stake-v[0-9]*' --output rust/programs/worker_stake/CHANGELOG.md",
    "changelog:all": "pnpm run changelog:sdk && pnpm run changelog:worker && pnpm run changelog:checker && pnpm run changelog:depin && pnpm run changelog:worker-stake"
  },
  "keywords": [
    "solana",
    "depin",
    "blockchain"
  ],
  "author": "",
  "license": "ISC"
}
